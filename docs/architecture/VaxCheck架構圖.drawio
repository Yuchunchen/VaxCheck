<mxCell id="p1-10" value="門診電腦・Chrome 瀏覽器（VaxCheck 外掛）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#15875A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="268" width="440" height="30" as="geometry"/></mxCell>
<mxCell id="p1-11" value="病患資料不離開這台電腦" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#15875A;fontSize=16;fontFamily=Helvetica;align=right;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="268" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="p1-12" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.2;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="306" width="350" height="690" as="geometry"/></mxCell>
<mxCell id="p1-13" value="健保雲端分頁" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="356" y="310" width="320" height="28" as="geometry"/></mxCell>
<mxCell id="p1-14" value="&lt;b&gt;讀取病歷資料&lt;/b&gt; &lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;medcloud.js&lt;/font&gt;&lt;br&gt;年齡、性別、診斷 ICD、用藥 ATC、檢驗、過敏、特殊給付、摘要旗標（如洗腎）&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;→ 整理成「病患事實」&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="358" y="344" width="314" height="140" as="geometry"/></mxCell>
<mxCell id="p1-15" value="&lt;b&gt;判定引擎&lt;/b&gt; &lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;engine/&lt;/font&gt;&lt;br&gt;疫苗規則 × 病患事實&lt;br&gt;→ 每支疫苗：能不能打、&lt;br&gt;哪天起、為什麼&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;同樣資料+同樣規則，結果必然相同&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="358" y="540" width="314" height="150" as="geometry"/></mxCell>
<mxCell id="p1-16" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="358" y="760" width="314" height="220" as="geometry"/></mxCell>
<mxCell id="p1-17" value="&lt;b&gt;結果面板&lt;/b&gt; &lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;panel/&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="372" y="766" width="290" height="30" as="geometry"/></mxCell>
<mxCell id="p1-18" value="&lt;b&gt;可接種&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E7F3EC;strokeColor=#1E7B4F;fontColor=#1E7B4F;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="372" y="802" width="138" height="46" as="geometry"/></mxCell>
<mxCell id="p1-19" value="&lt;b&gt;待確認&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#A86A12;fontColor=#A86A12;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="520" y="802" width="138" height="46" as="geometry"/></mxCell>
<mxCell id="p1-20" value="&lt;b&gt;尚未開打&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#2F5D8C;fontColor=#2F5D8C;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="372" y="858" width="138" height="46" as="geometry"/></mxCell>
<mxCell id="p1-21" value="&lt;b&gt;不符合&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8A94A0;fontColor=#8A94A0;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="520" y="858" width="138" height="46" as="geometry"/></mxCell>
<mxCell id="p1-22" value="&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;每張卡片寫出依據；需要醫師確認的條件有「是／否」鈕&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1C2B3A;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="372" y="916" width="290" height="56" as="geometry"/></mxCell>
<mxCell id="p1-23" value="&lt;b&gt;背景程式&lt;/b&gt; &lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;background.js&lt;/font&gt;&lt;br&gt;&lt;br&gt;・開啟／切換健保雲端與 NIIS 分頁、代按換卡&lt;br&gt;&lt;br&gt;・身分核對：身分證只做 SHA-256 雜湊比對，不保存&lt;br&gt;&lt;br&gt;・NIIS 接種史中繼：同一人才併入&lt;br&gt;&lt;br&gt;・載入疫苗規則：線上 → 快取 → 外掛內建" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="306" width="250" height="320" as="geometry"/></mxCell>
<mxCell id="p1-24" value="&lt;b&gt;本次病患暫存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;chrome.storage.session&lt;/font&gt;&lt;br&gt;接種史、醫師勾選&lt;br&gt;換病患或關閉瀏覽器即清除" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15875A;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="672" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="p1-25" value="&lt;b&gt;規則快取&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;chrome.storage.local&lt;/font&gt;&lt;br&gt;下載的疫苗規則&lt;br&gt;（不是病患資料）" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15875A;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="830" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="p1-26" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="306" width="220" height="214" as="geometry"/></mxCell>
<mxCell id="p1-27" value="NIIS 分頁" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1176" y="310" width="190" height="28" as="geometry"/></mxCell>
<mxCell id="p1-28" value="&lt;b&gt;讀取接種史&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;niis.js&lt;/font&gt;&lt;br&gt;疫苗代碼、接種日期、公費／自費&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;讀卡失敗不當成「從未接種」&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1174" y="344" width="192" height="160" as="geometry"/></mxCell>
<mxCell id="p1-29" value="&lt;b&gt;安全設計&lt;/b&gt;&lt;br&gt;&lt;br&gt;・&lt;b&gt;預設不可&lt;/b&gt;：查不到的資料回「需確認」，不會誤判成可打&lt;br&gt;&lt;br&gt;・NIIS 查到別的病患 → 不併入、面板提醒&lt;br&gt;&lt;br&gt;・病歷證據只「預勾」條件，醫師可取消&lt;br&gt;&lt;br&gt;・本工具是提醒，不取代臨床判斷" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3261E;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeometry x="1160" y="560" width="220" height="350" as="geometry"/></mxCell>
<mxCell id="p1-30" value="外部系統" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#5B6775;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="p1-31" value="&lt;b&gt;健保雲端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;medcloud2.nhi.gov.tw&lt;/font&gt;&lt;br&gt;用藥、檢驗、過敏、&lt;br&gt;特殊給付、病人摘要" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="250" height="140" as="geometry"/></mxCell>
<mxCell id="p1-32" value="外部系統" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#5B6775;fontSize=15;fontFamily=Helvetica;align=right;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="300" width="250" height="28" as="geometry"/></mxCell>
<mxCell id="p1-33" value="&lt;b&gt;NIIS&lt;/b&gt;&lt;br&gt;全國性預防接種&lt;br&gt;資訊管理系統&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;按「讀取健保卡及醫事人員卡」&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="344" width="250" height="160" as="geometry"/></mxCell>
<mxCell id="p1-34" value="&lt;b&gt;一次看診的流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 插醫事人員卡與健保卡&lt;br&gt;② 按 VaxCheck 圖示：自動開健保雲端與 NIIS&lt;br&gt;③ 讀取這位病患的病歷資料&lt;br&gt;④ 引擎判定，面板出現在健保雲端右側&lt;br&gt;⑤ NIIS 讀卡，接種史回傳並核對身分&lt;br&gt;⑥ 同一人才併入，面板自動重算劑次與間隔&lt;br&gt;⑦ 醫師按「是／否」確認條件，立即重算&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;換下一位：換插健保卡，再按一次圖示；舊資料自動清除&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="250" height="400" as="geometry"/></mxCell>
<mxCell id="p1-35" value="開啟工作區" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-6" target="p1-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-36" value="開啟／切換分頁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.2062;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-23" target="p1-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-37" value="開啟背景分頁" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2062;exitDx=0;exitDy=0;entryX=0;entryY=0.175;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-23" target="p1-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-38" value="③" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-31" target="p1-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-39" value="⑤" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.4375;exitDx=0;exitDy=0;entryX=1;entryY=0.4375;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-33" target="p1-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-40" value="接種史+身分雜湊" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15875A;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7875;exitDx=0;exitDy=0;entryX=1;entryY=0.5125;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-28" target="p1-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-41" value="⑥ 同一人 → 重算" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15875A;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.4688;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-23" target="p1-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-42" value="病患事實" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-14" target="p1-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-43" value="疫苗規則" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.9187;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-23" target="p1-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-44" value="④ 判定結果" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.3567;exitY=1;exitDx=0;exitDy=0;entryX=0.3567;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-15" target="p1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-45" value="⑦ 按「是／否」" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A86A12;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.7389;exitY=0;exitDx=0;exitDy=0;entryX=0.7389;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-16" target="p1-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-46" value="暫存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15875A;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-23" target="p1-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-47" value="疫苗規則怎麼來：改規則不必改程式，也不必重裝外掛" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1036" width="1640" height="30" as="geometry"/></mxCell>
<mxCell id="p1-48" value="&lt;b&gt;疾管署公告&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;接種計畫、Q&amp;amp;A、致醫界通函、&lt;br&gt;ICD 參考表&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="296" height="96" as="geometry"/></mxCell>
<mxCell id="p1-49" value="&lt;b&gt;轉譯成規則檔&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;Claude 轉譯成 rules/vaccines.yaml，&lt;br&gt;每條附官方出處&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="376" y="1076" width="296" height="96" as="geometry"/></mxCell>
<mxCell id="p1-50" value="&lt;b&gt;自動檢查&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;格式、代碼白名單、&lt;br&gt;單元與臨床情境測試&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="712" y="1076" width="296" height="96" as="geometry"/></mxCell>
<mxCell id="p1-51" value="&lt;b&gt;醫師核准&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;臨床醫師審核後&lt;br&gt;才發行&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1048" y="1076" width="296" height="96" as="geometry"/></mxCell>
<mxCell id="p1-52" value="&lt;b&gt;發行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;內建進外掛+推到 GitHub rules 分支&lt;br&gt;（外掛每天檢查一次）&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15875A;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1384" y="1076" width="296" height="96" as="geometry"/></mxCell>
<mxCell id="p1-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-48" target="p1-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-49" target="p1-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-50" target="p1-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-51" target="p1-52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-57" value="每天下載（不帶病患資料）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#15875A;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-52" target="p1-25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1528" y="1026"/><mxPoint x="1105" y="1026"/><mxPoint x="1105" y="885"/></Array></mxGeometry></mxCell>
<mxCell id="p1-58" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#5B6775&quot;&gt;線上規則讀不到、雜湊不符或版本不合時，自動改用外掛內建規則；面板頁尾「來源」顯示線上／快取／內建。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="1640" height="40" as="geometry"/></mxCell>
</root>
