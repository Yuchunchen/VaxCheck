<mxCell id="p1-2" value="系統架構：插卡、按一下，這位病患今天能公費打哪些疫苗" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=30;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="1320" height="44" as="geometry"/></mxCell>
<mxCell id="p1-3" value="檢核肺炎鏈球菌（依 PCV13/15、PPV23、PCV20/21 接種史）、流感、COVID-19。&lt;br&gt;病患資料只在門診電腦的瀏覽器裡；唯一的對外下載是疫苗規則，不帶任何病患資料。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#5B6775;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="1320" height="52" as="geometry"/></mxCell>
<mxCell id="p1-4" value="&lt;b&gt;醫師／護理師&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#0E4C92;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="166" width="180" height="66" as="geometry"/></mxCell>
<mxCell id="p1-5" value="&lt;b&gt;① 插卡&lt;/b&gt;&lt;br&gt;醫事人員卡+病患健保卡" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="166" width="200" height="66" as="geometry"/></mxCell>
<mxCell id="p1-6" value="&lt;b&gt;② 按瀏覽器右上角&lt;br&gt;VaxCheck 圖示&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#0E4C92;strokeColor=#0E4C92;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="800" y="166" width="250" height="66" as="geometry"/></mxCell>
<mxCell id="p1-7" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-4" target="p1-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p1-8" value="" style="edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;flowAnimation=1;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-5" target="p1-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
