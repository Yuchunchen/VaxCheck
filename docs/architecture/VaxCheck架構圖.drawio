</diagram>
<diagram id="p2" name="2 判定流程">
<mxGraphModel dx="1600" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" background="#FFFFFF" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="p2-1" value="判定流程：一支疫苗怎麼被分到面板四組" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=28;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="40" as="geometry"/></mxCell>
<mxCell id="p2-2" value="每位病患、每支疫苗都跑一次。原則：預設不可；查不到就問，不會猜成「可打」。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#5B6775;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="28" as="geometry"/></mxCell>
<mxCell id="p2-3" value="&lt;b&gt;可接種&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;今天就能公費打&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E7F3EC;strokeColor=#1E7B4F;fontColor=#1E7B4F;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="950" y="30" width="145" height="50" as="geometry"/></mxCell>
<mxCell id="p2-4" value="&lt;b&gt;待確認&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;確認一個條件就能打&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#A86A12;fontColor=#A86A12;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1105" y="30" width="145" height="50" as="geometry"/></mxCell>
<mxCell id="p2-5" value="&lt;b&gt;尚未開打&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;已是對象，還沒到日期&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#2F5D8C;fontColor=#2F5D8C;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1260" y="30" width="145" height="50" as="geometry"/></mxCell>
<mxCell id="p2-6" value="&lt;b&gt;不符合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#1C2B3A&quot;&gt;非對象、已完成等&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8A94A0;fontColor=#8A94A0;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1415" y="30" width="145" height="50" as="geometry"/></mxCell>
<mxCell id="p2-7" value="&lt;b&gt;病患事實&lt;/b&gt;（自動讀取）&lt;br&gt;・年齡、性別&lt;br&gt;・診斷 ICD、用藥 ATC、檢驗、摘要旗標（如洗腎）&lt;br&gt;・NIIS 接種史：疫苗、日期、公費／自費&lt;br&gt;・醫師勾選：原住民、孕婦、機構住民……" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="124" width="480" height="136" as="geometry"/></mxCell>
<mxCell id="p2-8" value="&lt;b&gt;疫苗規則&lt;/b&gt; &lt;font style=&quot;font-size:13px&quot; color=&quot;#5B6775&quot;&gt;rules/vaccines.yaml&lt;/font&gt;&lt;br&gt;・公費對象群（誰可以打）&lt;br&gt;・分階段開打日（10/1、11/2）&lt;br&gt;・劑次與間隔（8 週、12 週、1 年、5 年）&lt;br&gt;・禁忌（嚴重過敏）；每條附官方出處" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="124" width="480" height="136" as="geometry"/></mxCell>
<mxCell id="p2-9" value="&lt;b&gt;病歷證據先預勾&lt;/b&gt;&lt;br&gt;病歷命中 ICD/ATC/旗標 → 自動勾選條件並標出依據&lt;br&gt;（例：糖尿病 → 具潛在疾病；洗腎旗標 → 洗腎）&lt;br&gt;醫師可按「不符合，取消」&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1C2B3A&quot;&gt;查不到 ≠ 沒有：需要時仍會問醫師&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E7F3EC;strokeColor=#1E7B4F;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1080" y="124" width="480" height="136" as="geometry"/></mxCell>
<mxCell id="p2-10" value="&lt;b&gt;A 對象判定&lt;/b&gt;：每個條件回答「是／否／&lt;b&gt;不確定&lt;/b&gt;」" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="520" height="80" as="geometry"/></mxCell>
<mxCell id="p2-11" value="&lt;b&gt;「不確定」不是「否」&lt;/b&gt;：資料查不到（接種史未查、原住民身分等）&lt;br&gt;→ 回「需確認」，不會誤判成可打，也不會直接判不符合" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="640" height="80" as="geometry"/></mxCell>
<mxCell id="p2-12" value="&lt;b&gt;B 劑次判定&lt;/b&gt;：依 NIIS 接種史算下一劑與最早可打日" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="520" height="80" as="geometry"/></mxCell>
<mxCell id="p2-13" value="&lt;b&gt;C 保底與升級&lt;/b&gt;&lt;br&gt;保底 = 不必再確認就成立的日期&lt;br&gt;升級 = 醫師確認某條件後可以更早" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="570" width="520" height="96" as="geometry"/></mxCell>
<mxCell id="p2-14" value="&lt;b&gt;例&lt;/b&gt;：58 歲、10 月中看診&lt;br&gt;保底：第二階段 11/2 起可打流感&lt;br&gt;升級：若確認「具潛在疾病」→ 屬第一階段，今天就能打" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="570" width="640" height="96" as="geometry"/></mxCell>
<mxCell id="p2-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.8125;exitY=1;exitDx=0;exitDy=0;entryX=0.1731;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-7" target="p2-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p2-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.4375;exitY=1;exitDx=0;exitDy=0;entryX=0.8269;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-8" target="p2-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p2-17" value="預勾" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1E7B4F;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-9" target="p2-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="302"/><mxPoint x="890" y="302"/><mxPoint x="890" y="354"/></Array></mxGeometry></mxCell>
<mxCell id="p2-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2-10" target="p2-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p2-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2-12" target="p2-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p2-20" value="醫師勾了禁忌？&lt;br&gt;（嚴重過敏）" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;strokeWidth=1.5;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="712" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="p2-21" value="&lt;b&gt;不符合&lt;/b&gt;：禁忌，不列入可打" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8A94A0;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="880" y="728" width="680" height="68" as="geometry"/></mxCell>
