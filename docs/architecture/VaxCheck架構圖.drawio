<mxCell id="p3-64" value="符合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A86A12;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-61" target="p3-62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p3-65" value="11" style="shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#0E4C92;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1188" width="44" height="44" as="geometry"/></mxCell>
<mxCell id="p3-66" value="從未接種肺炎鏈球菌疫苗" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="1180" width="640" height="60" as="geometry"/></mxCell>
<mxCell id="p3-67" value="&lt;b&gt;今天可打&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1C2B3A&quot;&gt;1 劑 PCV20 或 PCV21&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E7F3EC;strokeColor=#1E7B4F;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="1180" width="730" height="60" as="geometry"/></mxCell>
<mxCell id="p3-68" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0E4C92;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-61" target="p3-66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p3-69" value="符合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1E7B4F;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-66" target="p3-67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p3-70" value="&lt;b&gt;「間隔」怎麼顯示&lt;/b&gt;：與上一劑的間隔已滿 → 今天可打（可接種）；還沒滿 → 顯示「X 日起可打」（尚未開打）。&lt;br&gt;&lt;b&gt;需要醫師確認的情境&lt;/b&gt;（IPD 高風險、洗腎、機構住民）：病歷有證據先自動勾選；沒有證據時，面板同時列出「未確認前」與「確認後」兩個日期，確認後今天就能打的放進「待確認」。&lt;br&gt;&lt;br&gt;&lt;b&gt;範例（虛構）&lt;/b&gt;：67 歲、洗腎、10 個月前打過 PCV13 → 第 8 條，已滿 8 週 → 今天可打。若不是洗腎、也不是機構住民或 IPD 高風險 → 第 9 條，要等滿 1 年。" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="1520" height="124" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
<diagram id="p4" name="4 流感與COVID-19">
<mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" background="#FFFFFF" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="p4-1" value="流感與 COVID-19：誰在第一階段、誰在第二階段" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=28;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="40" as="geometry"/></mxCell>
<mxCell id="p4-2" value="115 年度流感、115–116 年度 COVID-19 同日分兩階段開打；「具潛在疾病」同一題，勾一次兩支疫苗一起更新。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#5B6775;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="28" as="geometry"/></mxCell>
<mxCell id="p4-3" value="&lt;b&gt;第一階段：115/10/1（2026/10/1）起&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#1E7B4F;strokeColor=#1E7B4F;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="460" height="58" as="geometry"/></mxCell>
<mxCell id="p4-4" value="&lt;b&gt;第二階段：115/11/2（2026/11/2）起&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#2F5D8C;strokeColor=#2F5D8C;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="460" height="58" as="geometry"/></mxCell>
<mxCell id="p4-5" value="至疫苗用罄" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8A94A0;fontColor=#1C2B3A;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="460" height="58" as="geometry"/></mxCell>
<mxCell id="p4-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6775;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-3" target="p4-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p4-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6775;strokeWidth=1.8;fontColor=#1C2B3A;fontSize=14;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-4" target="p4-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="p4-8" value="流感疫苗（115 年度）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=21;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="740" height="34" as="geometry"/></mxCell>
<mxCell id="p4-9" value="&lt;b&gt;第一階段（10/1 起）&lt;/b&gt;&lt;br&gt;・65 歲以上長者；55 歲以上原住民&lt;br&gt;・醫事及衛生防疫相關人員&lt;br&gt;・安養、長照機構住民及工作人員&lt;br&gt;・滿 6 個月至國小入學前幼兒；孕婦&lt;br&gt;・&lt;b&gt;具潛在疾病者&lt;/b&gt;（高風險慢性病、BMI≥30、罕見疾病、重大傷病）&lt;br&gt;・6 個月內嬰兒之雙親或扶養者&lt;br&gt;・幼兒園、托育人員、保母&lt;br&gt;・國小至高中職、五專 1–3 年級學生&lt;br&gt;・禽畜養殖、動物園、動物防疫人員" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E7F3EC;strokeColor=#1E7B4F;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="740" height="244" as="geometry"/></mxCell>
<mxCell id="p4-10" value="&lt;b&gt;第二階段（11/2 起）&lt;/b&gt;：50–64 歲成人（接種年 − 出生年）" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#2F5D8C;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="740" height="56" as="geometry"/></mxCell>
<mxCell id="p4-11" value="&lt;b&gt;劑次&lt;/b&gt;：每季 1 劑；未滿 9 歲首次接種者 2 劑，間隔 4 週以上&lt;br&gt;&lt;b&gt;NIIS 接種對象別代碼&lt;/b&gt;(F01–F09)：面板直接列出，職業別優先" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="740" height="70" as="geometry"/></mxCell>
<mxCell id="p4-12" value="COVID-19 疫苗（115–116 年度）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=21;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="204" width="740" height="34" as="geometry"/></mxCell>
<mxCell id="p4-13" value="&lt;b&gt;第一階段（10/1 起）&lt;/b&gt;&lt;br&gt;・65 歲以上長者；55 歲以上原住民&lt;br&gt;・滿 6 個月以上免疫不全或免疫低下者&lt;br&gt;・安養、長照機構住民及工作人員；孕婦&lt;br&gt;・滿 6 個月以上&lt;b&gt;高風險對象&lt;/b&gt;：流感的潛在疾病條件，&lt;br&gt;&amp;nbsp;&amp;nbsp;另加結核病、失能、精神疾病、失智症&lt;br&gt;・醫事及衛生防疫人員&lt;br&gt;・幼兒園、托育人員、保母&lt;br&gt;・6 個月內嬰兒之雙親或扶養者&lt;br&gt;・從未接種的滿 6 個月至未滿 6 歲幼兒" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E7F3EC;strokeColor=#1E7B4F;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="244" width="740" height="244" as="geometry"/></mxCell>
<mxCell id="p4-14" value="&lt;b&gt;第二階段（11/2 起）&lt;/b&gt;：50–64 歲無高風險成人" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#2F5D8C;fontColor=#1C2B3A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="502" width="740" height="56" as="geometry"/></mxCell>
<mxCell id="p4-15" value="&lt;b&gt;劑次&lt;/b&gt;：1 劑，與前一劑間隔 12 週以上；6 個月至 4 歲未曾接種者 2 劑&lt;br&gt;65 歲以上、55 歲以上原住民、免疫低下者：6 個月後可再 1 劑" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DC;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="572" width="740" height="70" as="geometry"/></mxCell>
<mxCell id="p4-16" value="&lt;b&gt;同一題、兩支一起更新：「具潛在疾病」&lt;/b&gt;&lt;br&gt;病歷有下列 ICD 就自動預勾並標出依據：流感計畫附件1 高風險慢性病（63 項，例：糖尿病、慢性心肺肝腎疾病）、重大傷病、國健署公告罕見疾病、洗腎。BMI≥30 需醫師確認。&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1C2B3A&quot;&gt;重大傷病、罕見疾病的診斷碼只作推估，以健保卡註記或證明為準；醫師可取消預勾。&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E7B4F;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="666" width="1520" height="96" as="geometry"/></mxCell>
<mxCell id="p4-17" value="&lt;b&gt;範例（虛構）：58 歲、病歷有糖尿病，10 月 15 日看診&lt;/b&gt;&lt;br&gt;・病歷命中附件1（E08–E13 糖尿病）→ 自動預勾「具潛在疾病」→ 流感屬第一階段 → &lt;b&gt;今天可打&lt;/b&gt;&lt;br&gt;・COVID-19 同屬第一階段；距上一劑已滿 12 週 → &lt;b&gt;今天可打&lt;/b&gt;&lt;br&gt;・若沒有任何第一階段條件：兩支都是「11/2 起可打」；10/1–11/1 看診時放「待確認」，列出第一階段條件讓醫師按「是／否」" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#A86A12;fontColor=#1C2B3A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1520" height="124" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
