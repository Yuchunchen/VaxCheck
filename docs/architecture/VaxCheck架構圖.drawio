<mxCell id="p3-1" value="肺炎鏈球菌 PCV20/PCV21：先看是不是公費對象，再看以前打過什麼" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0E4C92;fontSize=28;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="40" as="geometry"/></mxCell>
<mxCell id="p3-2" value="依疾管署 115 年 8 月 10 日起公費計畫；年齡以「接種年 − 出生年」計算。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#5B6775;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1520" height="28" as="geometry"/></mxCell>
<mxCell id="p3-3" value="&lt;b&gt;65 歲以上長者&lt;/b&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="p3-4" value="&lt;b&gt;55–64 歲原住民&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1C2B3A&quot;&gt;醫師勾選原住民身分&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="370" y="120" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="p3-5" value="&lt;b&gt;19–64 歲 IPD 高風險對象&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1C2B3A&quot;&gt;脾臟功能缺損、免疫功能不全、人工耳植入、腦脊髓液滲漏、一年內接受抗癌治療之惡性腫瘤、&lt;br&gt;器官移植；病歷 ICD 依疾管署參考表自動預勾&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#0E4C92;fontColor=#1C2B3A;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="860" height="90" as="geometry"/></mxCell>
<mxCell id="p3-6" value="&lt;b&gt;任一符合 → 查 NIIS 接種史&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#FFFFFF&quot;&gt;PCV13、PCV15、PPV23、PCV20、PCV21，含公費／自費&lt;/font&gt;" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#0E4C92;strokeColor=#0E4C92;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="640" height="70" as="geometry"/></mxCell>
